# Copy to .env and fill in. Never commit the real .env.

# MySQL (RDS in production)
MYSQL_URL=jdbc:mysql://localhost:3306/shelfsync?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=shelfsync
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# AWS
AWS_REGION=us-east-1
# For LocalStack only; leave blank for real AWS.
AWS_ENDPOINT_OVERRIDE=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

INVENTORY_TABLE=shelfsync-inventory
INVOICE_BUCKET=shelfsync-invoices
INVOICE_URL_TTL=PT15M

# Invoice generation: "lambda" or "local"
INVOICE_GENERATOR=local
INVOICE_LAMBDA_FUNCTION=shelfsync-invoice-generator

# Billing
BILLING_CURRENCY=USD
BILLING_TAX_RATE=0.08
SELLER_NAME=ShelfSync Store
SELLER_ADDRESS=

# API auth (X-Api-Key header). Empty disables auth.
SHELFSYNC_API_KEY=
